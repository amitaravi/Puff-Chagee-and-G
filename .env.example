# Copy to .env and fill in. NEVER commit .env — it is in .gitignore.

# Provider key (use one)
OPENAI_API_KEY=
# GROQ_API_KEY=

# Optional OpenAI-compatible endpoint override (for Groq/proxies/self-hosted gateways)
# OPENAI_BASE_URL=
# OPENAI_API_BASE=

# Groq quick-start example:
# GROQ_API_KEY=your_groq_key
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# ARBITRA_MODEL_ADVOCATE=qwen/qwen3.8-27b
# ARBITRA_MODEL_JUDGE=qwen/qwen3.8-27b
# ARBITRA_MODEL_OFFICER=qwen/qwen3.8-27b

# Optional overrides
# ARBITRA_MODEL_ADVOCATE=gpt-4o-mini
# ARBITRA_MODEL_JUDGE=gpt-4o
# ARBITRA_MODEL_OFFICER=gpt-4o-mini
# ARBITRA_TEMPERATURE=0.0
# ARBITRA_CONFIDENCE_THRESHOLD=0.75
# ARBITRA_MAX_TOKENS=300      # useful for Groq OTPM limits
# ARBITRA_TOOLS=mock          # set to "real" once data/ is ready
# ARBITRA_STUB=1              # run the pipeline with canned verdicts, no API calls
